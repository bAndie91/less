# Sticky header presets for less (used with the --sticky-presets option).
#
# A block starts with an unindented line of patterns; the indented lines after
# it are --sticky-* options, one per line.  The text after the first "=" is
# the value up to the end of the line (no quoting).  The first block which
# matches the file wins.  Options given on the command line override a preset.
#
# A pattern is a glob matched against the name of the file.  A pattern which
# starts with "$" is a glob matched against the interpreter on the "#!" line
# of the file: the last component of its path, or if that is "env", of the
# first argument of env which is not an option or a NAME=value.
# A pattern :LINE:REGEXP matches a file which has a line (number LINE from 1,
# or any line if LINE is empty, or any line of the header, up to the first
# blank line, if LINE is H) matching REGEXP, which has no blanks in it:
# :1:^\[   ::^Content-Type:   :H:^From[[:blank:]]
# The file is read only if the name patterns and the $ patterns have not matched.
#
# --sticky-close names the lines which end a scope (fi, done, }, end ...), so
# that deeper lines after them (continuation lines, heredocs) are not shown
# under a header which is already closed.
#
# The regular expressions use only POSIX syntax, so they work with every
# regular expression library which less can be built with.
#
# Your own presets go in ~/.lesssticky (this file is used after it), or in the
# files named in the colon-separated list $LESSSTICKYPRESETS (then this file
# is used only if it is on the list).

# ---- indentation based -------------------------------------------------

# Python
*.py *.pyw *.pyi *.pyx $python*
    --sticky-indent=^[[:space:]]*((async[[:space:]]+)?def|class)[[:space:]]|^[[:space:]]*(if|elif|else|for|while|try|except|finally|with|match|case)([^[:alnum:]_].*)?:[[:space:]]*(#.*)?$
    --sticky-skip=^[[:space:]]*(#|$)

# Shell scripts
*.sh *.bash *.zsh *.ksh .bashrc .bash_profile .zshrc .profile $*sh
    --sticky-indent=^[[:space:]]*(function[[:space:]]|[[:alnum:]_.:@-]+[[:space:]]*\(\)|(if|elif|else|for|while|until|case|select)([^[:alnum:]_]|$))
    --sticky-close=^[[:space:]]*(fi|done|esac|\})([^[:alnum:]_]|$)
    --sticky-skip=^[[:space:]]*(#|$)

# Ruby
*.rb *.rake *.gemspec Rakefile Gemfile $ruby*
    --sticky-indent=^[[:space:]]*(def|class|module|if|elsif|else|unless|case|when|while|until|for|begin|rescue|ensure|do)([^[:alnum:]_?!]|$)|[[:space:]]do([[:space:]]*\|[^|]*\|)?[[:space:]]*$
    --sticky-close=^[[:space:]]*end([^[:alnum:]_?!]|$)
    --sticky-skip=^[[:space:]]*(#|$)

# Lua
*.lua $lua*
    --sticky-indent=^[[:space:]]*(local[[:space:]]+)?function([^[:alnum:]_]|$)|^[[:space:]]*(if|elseif|else|for|while|repeat)([^[:alnum:]_]|$)|(function[[:space:]]*\([^)]*\)|[[:space:]]do)[[:space:]]*$
    --sticky-close=^[[:space:]]*(end|until)([^[:alnum:]_]|$)
    --sticky-skip=^[[:space:]]*(--|$)

# Makefiles: targets, and conditionals
Makefile makefile GNUmakefile *.mk *.make
    --sticky-indent=^[^[:space:]#=:]+[[:space:]]*:([^=]|$)|^[[:space:]]*(ifeq|ifneq|ifdef|ifndef|else)([^[:alnum:]_]|$)
    --sticky-close=^[[:space:]]*(endif|endef)([^[:alnum:]_]|$)
    --sticky-skip=^[[:space:]]*(#|$)

# YAML: keys which have nested content, and list items
*.yml *.yaml
    --sticky-indent=^[[:space:]]*(-[[:space:]]+)?[^[:space:]#-][^#]*:[[:space:]]*(#.*)?$|^[[:space:]]*-([[:space:]]|$)
    --sticky-skip=^[[:space:]]*(#|$)

# JSON: keys which open an object or array
*.json *.jsonc *.geojson
    --sticky-indent=^[[:space:]]*"[^"]*"[[:space:]]*:[[:space:]]*[{[][[:space:]]*$
    --sticky-close=^[[:space:]]*[]}]

# HTML and XML: opening tags alone on their line
*.html *.htm *.xhtml *.xml *.xsl *.xslt *.svg *.plist *.rss
    --sticky-indent=^[[:space:]]*<[[:alpha:]]([^<>]*[^/<>])?>[[:space:]]*$
    --sticky-close=^[[:space:]]*</
    --sticky-skip=^[[:space:]]*<!--

# ---- curly brackets (indentation based; no brackets are counted) --------
# A header is a line which ends with "{", a line which starts with a control
# keyword, or a line which looks like a function signature (ends with ")")
# for the brace-on-its-own-line style.

# C family, C#, PHP, Perl, Terraform, nginx (# starts a comment or a directive)
*.c *.h *.cc *.cpp *.cxx *.hh *.hpp *.hxx *.m *.mm *.cs *.php *.pl *.pm *.t *.tf *.hcl nginx.conf $perl* $php*
    --sticky-indent=^[[:space:]]*[^[:space:]{].*\{[[:space:]]*(//.*)?$|^[[:space:]]*(if|else|for|foreach|while|do|switch|try|catch|finally|elsif|unless|until)([^[:alnum:]_]|$)|^[[:space:]]*[A-Za-z_][^;=]*\)[[:space:]]*$
    --sticky-close=^[[:space:]]*\}
    --sticky-skip=^[[:space:]]*(//|/\*|\*|#|$)

# JavaScript, TypeScript, Java, Go, Rust, Swift, Kotlin, Scala, Dart, Zig, D, Groovy
*.js *.mjs *.cjs *.jsx *.ts *.tsx *.java *.go *.rs *.swift *.kt *.kts *.scala *.dart *.zig *.d *.groovy *.gradle $node* $deno* $bun*
    --sticky-indent=^[[:space:]]*[^[:space:]{].*\{[[:space:]]*(//.*)?$|^[[:space:]]*(if|else|for|foreach|while|do|switch|try|catch|finally)([^[:alnum:]_]|$)|^[[:space:]]*[A-Za-z_][^;=]*\)[[:space:]]*$
    --sticky-close=^[[:space:]]*\}
    --sticky-skip=^[[:space:]]*(//|/\*|\*|$)

# CSS, SCSS, Less: counted braces (rules and at-rules nest, indentation is
# not reliable).  A "}" in the first column ends a top level rule.
*.css *.scss *.less
    --sticky-open=\{
    --sticky-lead=^[[:space:]]*\{
    --sticky-close=\}
    --sticky-ignore="([^"\\]|\\.)*"|'([^'\\]|\\.)*'|/\*.*\*/|//.*$
    --sticky-root=^\}

# ---- fixed levels --------------------------------------------------------

# Markdown: the level is the number of "#"
*.md *.markdown
    --sticky-header=^(#{1,6})[[:space:]]
    --sticky-level=len(\1)

# Org mode: the level is the number of "*"
*.org
    --sticky-header=^(\*+)[[:space:]]
    --sticky-level=len(\1)

# Diffs and patches: file, then hunk
*.diff *.patch
    --sticky-header=^(diff |Index: |\+\+\+ [^[:space:]])
    --sticky-header=^@@

# INI style files: sections
*.ini *.cfg *.toml *.desktop *.repo .gitconfig
    --sticky-header=^\[

# LaTeX
*.tex
    --sticky-header=^[[:space:]]*\\(part|chapter)\*?\{
    --sticky-header=^[[:space:]]*\\section\*?\{
    --sticky-header=^[[:space:]]*\\subsection\*?\{
    --sticky-header=^[[:space:]]*\\subsubsection\*?\{

# roff: man pages
*.nro *.roff *.man
    --sticky-header=^\.SH
    --sticky-header=^\.SS

# Dockerfile: build stages
Dockerfile Dockerfile.* Containerfile
    --sticky-header=^FROM[[:space:]]
